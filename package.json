{
  "name": "agentproof",
  "version": "0.0.0",
  "description": "Intent-aware runtime firewall for AI agent tool calls: MCP proxy, provenance-based risk, execution binding and tamper-evident evidence, with a Red/Blue agent lab",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "proxy": "node src/mcp-proxy.ts",
    "test": "node --test test/*.test.ts",
    "benchmark": "node benchmarks/security.ts",
    "benchmark:stdio": "node benchmarks/stdio.ts",
    "agents:live": "node --env-file-if-exists=.env agents/band.ts",
    "agents:offline": "node agents/offline.ts",
    "demo:e2e": "node agents/e2e.ts",
    "demo": "node demo/attack-demo.ts",
    "dashboard": "node src/dashboard/server.ts --evidence docs/demo/evidence.jsonl --mode \"DEMO (scripted agent, synthetic data)\"",
    "verify": "node src/verify-evidence.ts",
    "benchmark:guard": "node --expose-gc benchmarks/guard.ts",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@microsoft/agent-governance-sdk": "5.0.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@band-ai/sdk": "1.0.0"
  }
}
